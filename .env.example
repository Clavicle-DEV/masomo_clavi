# Copy this file to .env for local dev (and never commit the real .env).
# In production, set these as environment variables in your hosting platform's
# dashboard instead of a file.

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# Database (leave unset locally to use SQLite; set to a Postgres URL in production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# M-Pesa (manual — buyer sends money, you approve in /admin/mpesa-requests).
# Prices are in KES; both are optional and default to 200 / 5000 if unset.
MPESA_PRICE_DAY=50
MPESA_PRICE_MONTH=1300

# Your deployed URL, no trailing slash (used for password-reset links)
APP_DOMAIN=https://your-app-domain.com

# Email (for password reset links). Leave unset locally — reset links will
# print to the server console/log instead of actually emailing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=no-reply@yourdomain.com

# Secret key to authorize an external scheduler hitting
# /internal/send-expiry-reminders (daily renewal/trial-expiry emails).
# Leave unset to keep that endpoint disabled. See send_renewal_reminders.py
# for the alternative of running it as a script from your own cron instead.
CRON_SECRET=replace-with-a-long-random-string
